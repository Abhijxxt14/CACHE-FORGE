# CacheForge environment — copy to .env and adjust as needed

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=cacheforge
POSTGRES_PASSWORD=cacheforge
POSTGRES_DB=cacheforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Cache behaviour ───────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_NAMESPACE=cf
CACHE_MAX_ENTRIES=10000
CACHE_MAX_MEMORY_BYTES=104857600
CACHE_EVICTION_POLICY=lru
CACHE_TTL_JITTER=10
CACHE_NEGATIVE_TTL=30
CACHE_STAMPEDE_TIMEOUT=5.0
CACHE_LOCK_TTL=10000

# ── App ───────────────────────────────────────────────────────────────────────
INSTANCE_ID=local
LOG_LEVEL=INFO

